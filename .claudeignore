# =========================================================
# [1] 시스템 & 보안 & IDE (가장 중요)
# =========================================================
.git/
.gitignore
**/.idea/
**/.vscode/
**/.DS_Store
**/Thumbs.db

# 보안 키 및 환경 설정
**/.env
**/.env.*
**/secrets.yaml
**/key.properties
**/*.pem
**/*.key
**/*.keystore
**/*.jks

# =========================================================
# [2] 빌드 결과물 (모든 경로의 build 폴더 차단 ⭐)
# =========================================================
# front/build, backend/build 등 어디에 있든 build 폴더는 다 무시
**/build/
**/out/
**/bin/
**/.gradle/

# Java/Kotlin 컴파일 바이너리 (이게 목록에 엄청 떴었음)
**/*.class

# =========================================================
# [3] Frontend (Flutter) - 네이티브 & 생성 파일 차단
# =========================================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/

# Android/iOS 플랫폼 폴더 (front/android, front/ios 등 잡아냄)
**/android/
**/ios/
**/macos/
**/web/
**/linux/
**/windows/

# 자동 생성된 코드 (Riverpod, Freezed 등)
**/*.g.dart
**/*.freezed.dart
**/*.config.dart

# =========================================================
# [4] Backend (Spring Boot) & Database
# =========================================================
**/gradlew
**/gradlew.bat
**/gradle/wrapper/

# Redis 덤프 파일 (목록에 redis/data/dump.rdb가 보였음)
**/*.rdb
**/*.aof

# =========================================================
# [5] 미디어 & 바이너리 & 로그 (토큰 절약)
# =========================================================
# 이미지/영상
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.svg
**/*.ico
**/*.webp
**/*.ttf
**/*.otf
**/*.mp4
**/*.mov

# 압축/문서
**/*.pdf
**/*.zip
**/*.tar.gz
**/*.jar
**/*.war
**/*.ear

# 로그
*.log
**/logs/

# 불필요함
flutter_front
