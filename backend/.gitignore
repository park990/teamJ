# -----------------------------------------------------------------------
# Recommended .gitignore for Spring Boot (Gradle/Maven) Backend Projects
# -----------------------------------------------------------------------

# Compiled / Build Output
/build/
/out/
/target/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip

# Log Files
*.log

# Miscellaneous
HELP.md

# Gradle Specific
.gradle/
!gradle/wrapper/gradle-wrapper.jar  # Wrapper JAR은 유지

# STS (Spring Tool Suite) / Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
/bin/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/

# Virtual machine crash logs
hs_err_pid*
replay_pid*


/.env

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini