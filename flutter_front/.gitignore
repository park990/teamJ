# -----------------------------------------------------------------------
# Recommended .gitignore for Flutter/Dart Projects (inside flutter_front/)
# -----------------------------------------------------------------------

# Compiled / Build Output
/build/
**/doc/api/
/coverage/

# Dart Tooling and Cache
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
.packages

# Lock file (Usually generated by 'flutter pub get' or 'dart pub get')
# Including pubspec.lock can help ensure all team members use the exact same package versions.
# If you want to manage versions manually, you can uncomment the next line:
# /pubspec.lock

# IDE & Config files (Only keep if you use IntelliJ/VS Code)
.idea/
.vscode/
*.iml
*.iws
*.ipr

# Mobile Platform Specific: Android
# Mandatory exclusion for local paths and cache
/android/local.properties
/android/.gradle/
/android/key.properties
/android/app/build/
/android/app/debug/
/android/app/profile/
/android/app/release/

# Mobile Platform Specific: iOS/macOS
/ios/.symlinks/
/ios/Pods/
/ios/Flutter/.last_build_id
/ios/Podfile.lock
/macos/Pods/
/macos/Flutter/GeneratedPluginRegistrant.swift

# Symbolication and Obfuscation related (Keep these)
app.*.symbols
app.*.map.json

# Other Misc Files
.DS_Store
.history